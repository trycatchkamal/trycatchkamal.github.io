---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Contact from '../components/Contact.astro';
import resumeData from '../data/resume.json';

const { openSource, openSourceStats, profile } = resumeData;

// Contributions lead with the featured ones; my own projects use an explicit
// `order` so the AI tooling comes first regardless of what is featured.
const featuredFirst = (a, b) => Number(b.featured ?? false) - Number(a.featured ?? false);
const byOrder = (a, b) => (a.order ?? 99) - (b.order ?? 99);
const contributions = openSource.filter((p) => p.kind === 'contribution').sort(featuredFirst);
const projects = openSource.filter((p) => p.kind === 'project').sort(byOrder);

const groups = [
  {
    id: 'contributions',
    eyebrow: 'Contributions',
    title: 'Merged into other people’s projects',
    lede: 'Pull requests accepted into tools your team probably already has open.',
    items: contributions
  },
  {
    id: 'projects',
    eyebrow: 'My own projects',
    title: 'Built and maintained by me',
    lede: 'Libraries and tooling that came out of problems I hit on real work.',
    items: projects
  }
];
---

<Layout
  title={`Open Source Projects & Contributions - ${profile.name}`}
  description="Open source work by Kamal Raj Sekar: contributions to Google Gemini CLI and VS Code Copilot Chat, plus tools for AI agents, testing, and developer workflows."
>
  <Header />
  <main>
    <section class="section-dark">
      <div class="mx-auto max-w-7xl px-6 py-20 md:px-8 md:py-28">
        <p class="eyebrow-dark">Open source</p>
        <h1 class="mt-6 max-w-4xl text-5xl font-bold leading-[1.02] tracking-[-0.045em] md:text-[4rem] md:leading-[1]">
          Open source.
        </h1>
        <p class="mt-7 max-w-3xl text-lg leading-relaxed text-slate-300">
          Projects, tools, and contributions across AI-assisted development,
          testing and developer tooling, and a few decentralised apps along the
          way.
        </p>

        <a
          href={openSourceStats.profile}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary-dark mt-10"
        >
          Follow me on GitHub <span class="ml-2" aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    {groups.map((group, groupIndex) => (
      <section id={group.id} class={groupIndex === 0 ? 'section-paper' : 'section-light'}>
        <div class="mx-auto max-w-7xl px-6 py-20 md:px-8 md:py-28">
          <div class="max-w-3xl">
            <p class="eyebrow">{group.eyebrow}</p>
            <h2 class="section-title">{group.title}</h2>
            <p class="section-lede">{group.lede}</p>
          </div>

          <div class="mt-14 grid gap-x-6 gap-y-8 md:grid-cols-2 lg:grid-cols-3">
            {group.items.map((project) => (
              <a
                href={project.link}
                target="_blank"
                rel="noopener noreferrer"
                class:list={[
                  'group relative flex flex-col rounded-2xl p-6 transition duration-300 hover:-translate-y-1 hover:shadow-xl',
                  project.featured
                    ? 'border-2 border-blue-600 bg-white shadow-md ring-1 ring-blue-600/10'
                    : 'border border-slate-200 bg-white shadow-sm hover:border-blue-300'
                ]}
              >
                {project.featured && (
                  <span class="absolute -top-2.5 left-6 rounded-full bg-blue-600 px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-[0.1em] text-white shadow-sm">
                    Featured
                  </span>
                )}

                {project.subtitle && (
                  <p class="mb-1.5 text-xs font-bold uppercase tracking-[0.14em] text-blue-600">
                    {project.subtitle}
                  </p>
                )}
                <h3 class="text-lg font-bold leading-snug tracking-[-0.01em] text-slate-950 transition-colors group-hover:text-blue-600">
                  {project.title}
                </h3>

                <p class="mt-1.5 font-mono text-xs text-slate-400">{project.org}</p>

                {(project.language || project.license) && (
                  <div class="mt-3 flex flex-wrap items-center gap-2 text-xs">
                    {project.language && (
                      <span class="inline-flex items-center gap-1.5 font-semibold text-slate-700">
                        <span class="h-2 w-2 rounded-full bg-blue-500" aria-hidden="true"></span>
                        {project.language}
                      </span>
                    )}
                    {project.license && (
                      <span class="rounded border border-slate-200 px-1.5 py-0.5 font-medium text-slate-500">
                        {project.license}
                      </span>
                    )}
                  </div>
                )}

                <p class="mt-4 flex-1 text-sm leading-relaxed text-slate-600">
                  {project.description}
                </p>

                {project.tags && (
                  <div class="mt-5 flex flex-wrap gap-1.5">
                    {project.tags.map((tag) => (
                      <span
                        class:list={[
                          'rounded-md px-2 py-1 text-[11px] font-medium',
                          // AI tags carry the theme of the page, so they lead.
                          /^(AI agents|MCP|LLM behaviour|Copilot SDK)$/.test(tag)
                            ? 'bg-blue-50 font-semibold text-blue-700'
                            : 'bg-slate-100 text-slate-600'
                        ]}
                      >
                        {tag}
                      </span>
                    ))}
                  </div>
                )}

                <span class="mt-5 inline-flex items-center text-sm font-semibold text-blue-600">
                  {project.kind === 'contribution' ? 'View the work' : 'View on GitHub'}
                  <span class="ml-1 inline-block transition group-hover:translate-x-1" aria-hidden="true">↗</span>
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>
    ))}
  </main>
  <Contact />
</Layout>
