---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Expertise from '../components/Expertise.astro';
import OpenSource from '../components/OpenSource.astro';
import Contact from '../components/Contact.astro';
import resumeData from '../data/resume.json';
---

<Layout
  title={`${resumeData.profile.name} - AI Consultant & Tech Coach`}
  description="I help technology leaders and their teams put AI to work across the engineering process and ship quality software, backed by proven engineering practices."
>
  <Header />
  <main>
    <Hero />
    <Expertise />
    <OpenSource />
  </main>

  <Contact />
</Layout>
