---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Contact from '../components/Contact.astro';
import resumeData from '../data/resume.json';

const { profile, books, publications, writing } = resumeData;
---

<Layout
  title={`Publications - ${profile.name}`}
  description="Books on TDD and AI-assisted development, research papers on agentic refactoring, and a newsletter on AI, software engineering, and technical agility."
>
  <Header />
  <main>
    <section class="section-dark">
      <div class="mx-auto max-w-7xl px-6 py-20 md:px-8 md:py-28">
        <p class="eyebrow-dark">Publications</p>
        <h1 class="mt-6 max-w-4xl text-5xl font-bold leading-[1.02] tracking-[-0.045em] md:text-[4rem] md:leading-[1]">
          Books &amp; writings.
        </h1>
        <p class="mt-7 max-w-3xl text-lg leading-relaxed text-slate-300 md:text-xl">
          Passing on what I&rsquo;ve learned through books, research papers, and a
          newsletter &mdash; on AI, software engineering, and technical agility.
        </p>

      </div>
    </section>

    <!-- Books -->
    <section id="books" class="section-light scroll-mt-24">
      <div class="mx-auto max-w-7xl px-6 py-20 md:px-8 md:py-28">
        <div class="max-w-3xl">
          <p class="eyebrow">Books</p>
          <h2 class="section-title">Three books on Leanpub.</h2>
          <p class="section-lede">
            On test-driven development, and on working with AI without giving up
            the practices that keep code honest.
          </p>
        </div>

        <div class="mt-14 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {books.map((book) => (
            <a
              href={book.link}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm transition duration-300 hover:-translate-y-1 hover:border-blue-300 hover:shadow-xl"
            >
              <div class="flex h-72 items-center justify-center overflow-hidden bg-slate-100 p-6">
                <img
                  src={book.image}
                  alt={`Cover of ${book.title}`}
                  loading="lazy"
                  class="h-full w-auto max-w-full object-contain transition-transform duration-300 group-hover:scale-105"
                />
              </div>
              <div class="flex flex-1 flex-col p-6">
                <h3 class="text-lg font-bold leading-snug tracking-[-0.01em] text-slate-950 transition-colors group-hover:text-blue-600">
                  {book.title}
                </h3>
                <p class="mt-2 text-sm text-slate-500">{book.authors}</p>
                <p class="mt-4 flex-1 text-sm leading-relaxed text-slate-600">
                  {book.description}
                </p>
                <span class="mt-6 inline-flex items-center font-semibold text-blue-600">
                  View on Leanpub
                  <span class="ml-1 inline-block transition group-hover:translate-x-1" aria-hidden="true">↗</span>
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Research -->
    <section id="research" class="section-paper scroll-mt-24">
      <div class="mx-auto max-w-7xl px-6 py-20 md:px-8 md:py-28">
        <div class="max-w-3xl">
          <p class="eyebrow">Research</p>
          <h2 class="section-title">Two published papers.</h2>
          <p class="section-lede">
            A preprint on agentic refactoring, and a white paper on putting AI
            agents into product teams.
          </p>
        </div>

        <div class="mt-14 grid items-stretch gap-6 lg:grid-cols-2">
          {publications.map((paper) => (
            <article class="flex flex-col overflow-hidden rounded-3xl border border-slate-900 bg-slate-950 text-white shadow-xl">
              <div class="flex flex-1 flex-col p-8 md:p-9">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="inline-flex items-center rounded-full bg-cyan-300/15 px-3 py-1 text-xs font-semibold text-cyan-200">
                    {paper.type}
                  </span>
                  {paper.community && (
                    <span class="inline-flex items-center rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-slate-200">
                      {paper.community}
                    </span>
                  )}
                  <span class="text-xs text-slate-400">
                    {paper.year} · {paper.publisher}
                  </span>
                </div>

                <h3 class="mt-5 text-2xl font-bold leading-tight tracking-[-0.03em] md:text-3xl">
                  {paper.title}
                </h3>
                <p class="mt-3 text-sm text-slate-400">{paper.authors}</p>
                <p class="mt-5 flex-1 leading-relaxed text-slate-300">
                  {paper.summary ?? paper.description}
                </p>

                {paper.metrics && (
                  <dl class="mt-7 grid grid-cols-3 gap-4 border-t border-slate-800 pt-6">
                    {paper.metrics.map((metric) => (
                      <div>
                        <dd class="text-xl font-bold tracking-[-0.03em] text-cyan-300">
                          {metric.value}
                        </dd>
                        <dt class="mt-1 text-xs leading-snug text-slate-400">{metric.label}</dt>
                      </div>
                    ))}
                  </dl>
                )}

                <div class="mt-8 flex flex-wrap gap-3">
                  <a
                    href={paper.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center rounded-full bg-cyan-300 px-5 py-2.5 text-sm font-semibold text-slate-950 transition hover:bg-white"
                  >
                    Read it <span class="ml-1.5" aria-hidden="true">↗</span>
                  </a>
                  {paper.doi && (
                    <a
                      href={paper.doi}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center rounded-full border border-slate-600 px-5 py-2.5 text-sm font-semibold text-slate-200 transition hover:border-cyan-300 hover:text-cyan-200"
                    >
                      DOI
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- Writing -->
    <section id="writing" class="section-light scroll-mt-24">
      <div class="mx-auto max-w-7xl px-6 py-20 md:px-8 md:py-28">
        <div class="max-w-3xl">
          <p class="eyebrow">Newsletter</p>
          <h2 class="section-title">{writing.name}</h2>
          <p class="section-lede">{writing.tagline}</p>
        </div>

        <div class="mt-14 grid gap-6 lg:grid-cols-2">
          {writing.posts.map((post) => (
            <a
              href={post.link}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-7 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-blue-300 hover:shadow-xl md:p-8"
            >
              <p class="text-xs font-bold uppercase tracking-[0.14em] text-blue-600">
                {post.date}
              </p>
              <h3 class="mt-4 text-xl font-bold leading-snug tracking-[-0.02em] text-slate-950 transition-colors group-hover:text-blue-600">
                {post.title}
              </h3>
              <p class="mt-4 flex-1 leading-relaxed text-slate-600">{post.summary}</p>
              <span class="mt-6 inline-flex items-center font-semibold text-blue-600">
                Read it
                <span class="ml-1 inline-block transition group-hover:translate-x-1" aria-hidden="true">↗</span>
              </span>
            </a>
          ))}
        </div>

        <div class="mt-10">
          <a href={writing.link} target="_blank" rel="noopener noreferrer" class="btn-primary">
            Read the newsletter <span class="ml-2" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Contact />
</Layout>
