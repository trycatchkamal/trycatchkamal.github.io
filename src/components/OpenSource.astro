---
import resumeData from '../data/resume.json';
const { openSource } = resumeData;

// Picked by hand rather than by stars: the two that are real code in tools
// most teams already have open.
const notable = openSource.filter((p) => p.homepage);

// Keep one decimal below 10k (9.9k, not 9k) so counts don't round down hard.
const formatStars = (n) =>
  n >= 10000 ? `${Math.round(n / 1000)}k`
  : n >= 1000 ? `${(n / 1000).toFixed(1)}k`
  : `${n}`;
---

<section id="open-source" class="section-light">
  <div class="mx-auto max-w-7xl px-6 py-20 md:px-8 md:py-28">
    <div class="max-w-3xl">
      <p class="eyebrow">Open source</p>
      <h2 class="section-title">Featured contributions.</h2>
      <p class="section-lede">
        Merged pull requests in open source projects and tools that teams use
        every day.
      </p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-2">
      {notable.map((project) => (
        <a
          href={project.link}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition duration-300 hover:-translate-y-1 hover:border-blue-300 hover:shadow-xl"
        >
          <div class="flex items-start justify-between gap-3">
            <div>
              {project.subtitle && (
                <p class="mb-1.5 text-xs font-bold uppercase tracking-[0.14em] text-blue-600">
                  {project.subtitle}
                </p>
              )}
              <h3 class="text-lg font-bold leading-snug tracking-[-0.01em] text-slate-950 transition-colors group-hover:text-blue-600">
                {project.title}
              </h3>
            </div>
            {project.stars && (
              <span class="flex flex-shrink-0 items-center gap-1 rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">
                <svg class="h-3 w-3" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.958a1 1 0 00.95.69h4.162c.969 0 1.371 1.24.588 1.81l-3.367 2.446a1 1 0 00-.363 1.118l1.286 3.958c.3.922-.755 1.688-1.538 1.118l-3.366-2.446a1 1 0 00-1.176 0l-3.367 2.446c-.783.57-1.838-.196-1.538-1.118l1.287-3.958a1 1 0 00-.364-1.118L2.063 9.385c-.783-.57-.38-1.81.588-1.81h4.161a1 1 0 00.951-.69l1.286-3.958z" />
                </svg>
                {formatStars(project.stars)}
              </span>
            )}
          </div>

          <p class="mt-1.5 font-mono text-xs text-slate-400">{project.org}</p>

          <p class="mt-4 flex-1 text-sm leading-relaxed text-slate-600">
            {project.blurb ?? project.description}
          </p>

          <span class="mt-6 inline-flex items-center text-sm font-semibold text-blue-600">
            View the pull request
            <span class="ml-1 inline-block transition group-hover:translate-x-1" aria-hidden="true">↗</span>
          </span>
        </a>
      ))}
    </div>

    <div class="mt-10">
      <a href="/open-source" class="btn-ghost">
        See everything I&rsquo;ve worked on
        <span class="ml-2" aria-hidden="true">→</span>
      </a>
      <p class="mt-3 text-sm text-slate-500">
        Plus {openSource.length - notable.length} more &mdash; contributions to
        GitHub&rsquo;s awesome-copilot, Akka HTTP and Nostr Development Kit, and my
        own tools like spec-tracer and playwright-specgen.
      </p>
    </div>
  </div>
</section>
