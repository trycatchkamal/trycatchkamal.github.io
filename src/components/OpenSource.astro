---
import resumeData from '../data/resume.json';
const { openSource } = resumeData;
---

<section id="open-source" class="section-container bg-gradient-to-br from-green-50 to-emerald-50">
  <div class="mb-12 scroll-mt-24 text-center">
    <h2 class="text-3xl md:text-4xl font-bold mb-3 text-gray-900 flex items-center justify-center">
      <svg class="w-10 h-10 mr-3 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
      </svg>
      Open Source Contributions
    </h2>
    <p class="text-gray-600 text-lg">Contributing to the developer community</p>
  </div>

  <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
    {openSource.map((project, index) => (
      <a
        href={project.link}
        target="_blank"
        rel="noopener noreferrer"
        class="group bg-white rounded-xl p-6 shadow-lg hover:shadow-xl transition-all duration-300 border-2 border-transparent hover:border-green-400 hover:scale-105"
      >
        <div class="flex items-start mb-4">
          <div class="bg-green-100 rounded-lg p-3 mr-4 group-hover:bg-green-500 transition-colors">
            <svg class="w-6 h-6 text-green-600 group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
            </svg>
          </div>
          <div class="flex-1">
            <h3 class="text-lg font-bold text-gray-900 mb-2 group-hover:text-green-600 transition-colors line-clamp-2">
              {project.title}
            </h3>
          </div>
        </div>
        <p class="text-gray-600 text-sm mb-4 line-clamp-3">{project.description}</p>
        <div class="flex items-center text-green-600 font-medium text-sm group-hover:text-green-700">
          <span>View Contribution</span>
          <svg class="w-4 h-4 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </div>
      </a>
    ))}

    {/* Card for '...and many more' */}
    <a
      href="https://github.com/trycatchkamal"
      target="_blank"
      rel="noopener noreferrer"
      class="group bg-white rounded-xl p-6 shadow-lg hover:shadow-xl transition-all duration-300 border-2 border-transparent hover:border-green-400 hover:scale-105 flex flex-col justify-between"
    >
      <div class="flex items-start mb-4">
        <div class="bg-green-100 rounded-lg p-3 mr-4 group-hover:bg-green-500 transition-colors">
          <svg class="w-6 h-6 text-green-600 group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0C5.373 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.565 21.8 24 17.303 24 12c0-6.627-5.373-12-12-12z"/>
          </svg>
        </div>
        <div class="flex-1">
          <h3 class="text-lg font-bold text-gray-900 mb-2 group-hover:text-green-600 transition-colors line-clamp-2">
            ...and many more
          </h3>
        </div>
      </div>
      <p class="text-gray-600 text-sm mb-4 line-clamp-3">Explore more of my open source contributions on GitHub.</p>
      <div class="flex items-center text-green-600 font-medium text-sm group-hover:text-green-700">
        <span>Visit GitHub</span>
        <svg class="w-4 h-4 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </div>
    </a>
  </div>
</section>
