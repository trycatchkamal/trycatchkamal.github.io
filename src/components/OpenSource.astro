---
import resumeData from '../data/resume.json';
const { openSource } = resumeData;
---

<section id="open-source" class="section-container">
  <div class="mb-12 scroll-mt-24">
    <h2 class="text-3xl md:text-4xl font-semibold mb-2 text-gray-900">💻 Open Source Contributions</h2>
  </div>

  <div class="grid md:grid-cols-2 gap-6">
    {openSource.map(project => (
      <a
        href={project.link}
        target="_blank"
        rel="noopener noreferrer"
        class="card group"
      >
        <h3 class="text-lg font-semibold text-gray-900 mb-2 group-hover:text-blue-500 transition-colors">
          {project.title}
        </h3>
        <p class="text-gray-600 text-sm">{project.description}</p>
      </a>
    ))}
  </div>
</section>
