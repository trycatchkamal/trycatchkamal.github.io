---
import resumeData from '../data/resume.json';
const { profile } = resumeData;

// Solid brand colours so each chip reads distinctly against the dark hero.
// Inline styles because utility class names built inside this array get
// purged from the CSS bundle.
const availability = [
  { label: 'AI consulting', style: 'background-color:#22d3ee; color:#06282e;' },
  { label: 'Tech coaching', style: 'background-color:#fcd34d; color:#3a2503;' },
  { label: '1:1 mentoring', style: 'background-color:#34d399; color:#04291d;' },
  { label: 'Conference talks', style: 'background-color:#f6aaaa; color:#1c1c3c;' }
];

const roles = ['AI Consultant', 'Tech Coach', 'Author', 'Conference Speaker', 'SaaS Entrepreneur'];
---

<section id="top" class="section-dark relative overflow-hidden">
  <!-- soft glow behind the avatar -->
  <div
    class="pointer-events-none absolute -top-24 left-1/2 h-80 w-80 -translate-x-1/2 rounded-full bg-cyan-300/10 blur-3xl md:left-24 md:h-96 md:w-96 md:translate-x-0"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-5xl px-6 py-20 md:px-8 md:py-28">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:gap-7">
      <img
        src={profile.avatar}
        alt={`Portrait of ${profile.name}`}
        width="128"
        height="128"
        class="h-28 w-28 flex-shrink-0 rounded-full object-cover object-top ring-2 ring-cyan-300/40 ring-offset-4 ring-offset-slate-950 md:h-40 md:w-40"
      />

      <div>
        <h1 class="text-4xl font-bold leading-[1.05] tracking-[-0.04em] md:text-6xl md:leading-[1]">
          Hi! <br/> I&rsquo;m {profile.name}.
        </h1>
        <p class="mt-3 text-lg font-medium text-cyan-100 md:text-xl">
          {roles.join(' · ')}
        </p>
      </div>
    </div>

    <div class="mt-9 flex flex-wrap items-center gap-2">
      <span class="text-xs font-bold uppercase tracking-[0.18em] text-slate-400">
        Available for
      </span>
      {availability.map((item) => (
        <span
          class="inline-flex items-center rounded-full px-3.5 py-1.5 text-sm font-semibold"
          style={item.style}
        >
          {item.label}
        </span>
      ))}
    </div>

    <p class="mt-8 max-w-3xl text-lg leading-relaxed text-slate-300 md:text-xl">
      {profile.intro}
    </p>

    <div class="mt-9 flex flex-wrap gap-3">
      <a href="/services" class="btn-primary-dark">
        Hire me <span class="ml-2" aria-hidden="true">↗</span>
      </a>
      <a href="/published-work" class="btn-ghost-dark">View my work</a>
    </div>

    <dl class="mt-14 flex flex-wrap gap-x-12 gap-y-6 border-t border-slate-800 pt-8">
      <div>
        <dt class="sr-only">Engineers trained</dt>
        <dd class="text-3xl font-bold text-white">50+</dd>
        <p class="mt-1 text-sm text-slate-400">Engineers trained</p>
      </div>
      <div>
        <dt class="sr-only">Books published</dt>
        <dd class="text-3xl font-bold text-white">3</dd>
        <p class="mt-1 text-sm text-slate-400">Books on TDD &amp; AI</p>
      </div>
      <div>
        <dt class="sr-only">AI SaaS products built</dt>
        <dd class="text-3xl font-bold text-white">2</dd>
        <p class="mt-1 text-sm text-slate-400">AI SaaS products built</p>
      </div>
    </dl>
  </div>
</section>
