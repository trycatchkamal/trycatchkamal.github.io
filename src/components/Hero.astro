---
import resumeData from '../data/resume.json';
const { profile, summary, whitepaper, ampyard } = resumeData;

// Function to make whitepaper title and Ampyard clickable in text
function processText(text: string) {
  const whitepaperPattern = `'${whitepaper.title}'`;
  const ampyardPattern = ampyard.name;

  // Check if text contains both
  if (text.includes(whitepaperPattern) && text.includes(ampyardPattern)) {
    // Split by Ampyard first, then by whitepaper in the second part
    const ampyardParts = text.split(ampyardPattern);
    const whitepaperParts = ampyardParts[1].split(whitepaperPattern);
    return {
      parts: [ampyardParts[0], whitepaperParts[0], whitepaperParts[1]],
      hasWhitepaper: true,
      hasAmpyard: true
    };
  } else if (text.includes(whitepaperPattern)) {
    const parts = text.split(whitepaperPattern);
    return { parts, hasWhitepaper: true, hasAmpyard: false };
  } else if (text.includes(ampyardPattern)) {
    const parts = text.split(ampyardPattern);
    return { parts, hasWhitepaper: false, hasAmpyard: true };
  }
  return { parts: [text], hasWhitepaper: false, hasAmpyard: false };
}
---

<section id="about" class="section-container">
  <div class="grid lg:grid-cols-2 gap-12 items-center">
    <!-- Left: Hero -->
    <div class="text-center lg:text-left">
      <img
        src={profile.avatar}
        alt={profile.name}
        class="w-40 h-40 md:w-48 md:h-48 rounded-full mx-auto lg:mx-0 mb-6 object-cover shadow-xl ring-4 ring-blue-100"
      />

      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-4 text-gray-900 leading-tight">
        {profile.name}
      </h1>

      <p class="text-lg md:text-xl text-gray-600 mb-6 leading-relaxed">
        {profile.tagline}
      </p>

      <!-- Social Links -->
      <div class="flex gap-4 justify-center lg:justify-start mb-6">
        <a
          href={`mailto:${profile.email}`}
          class="text-gray-600 hover:text-blue-600 transition-colors"
          aria-label="Email"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
          </svg>
        </a>
        <a
          href={`https://linkedin.com/in/${profile.linkedin}`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-600 hover:text-blue-600 transition-colors"
          aria-label="LinkedIn"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
          </svg>
        </a>
        <a
          href={`https://github.com/${profile.github}`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-600 hover:text-blue-600 transition-colors"
          aria-label="GitHub"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
          </svg>
        </a>
        <a
          href={`https://twitter.com/${profile.twitter}`}
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-600 hover:text-blue-600 transition-colors"
          aria-label="Twitter"
        >
          <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
            <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
          </svg>
        </a>
      </div>

      <div class="flex flex-wrap gap-4 justify-center lg:justify-start">
        <a
          href={`mailto:${profile.email}`}
          class="inline-flex items-center bg-blue-500 hover:bg-blue-700 text-white font-semibold px-6 py-3 rounded-lg transition-all duration-200 shadow-lg hover:shadow-xl hover:scale-105"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          Get in Touch
        </a>
        <button
          id="view-experience-btn"
          class="inline-flex items-center bg-white hover:bg-gray-50 text-blue-600 font-semibold px-6 py-3 rounded-lg transition-all duration-200 shadow-md hover:shadow-lg border-2 border-blue-500"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          View Experience
        </button>
      </div>
    </div>

    <!-- Right: About Me -->
    <div class="bg-gradient-to-br from-blue-50 to-indigo-50 p-8 rounded-2xl shadow-xl">
      <h2 class="text-2xl md:text-3xl font-bold mb-6 text-gray-900 flex items-center">
        <svg class="w-8 h-8 mr-3 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
        </svg>
        About Me
      </h2>
      <div class="prose prose-lg max-w-none">
        {summary.split('\n\n').map(para => {
          const { parts, hasWhitepaper, hasAmpyard } = processText(para.trim());
          return (
            <p class="mb-4 text-gray-700 leading-relaxed">
              {hasWhitepaper && hasAmpyard ? (
                <>
                  {parts[0]}
                  <a
                    href={ampyard.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-blue-600 hover:text-blue-700 hover:underline font-medium"
                  >
                    {ampyard.name}
                  </a>
                  {parts[1]}
                  <a
                    href={whitepaper.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-blue-600 hover:text-blue-700 hover:underline font-medium"
                  >
                    '{whitepaper.title}'
                  </a>
                  {parts[2]}
                </>
              ) : hasWhitepaper ? (
                <>
                  {parts[0]}
                  <a
                    href={whitepaper.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-blue-600 hover:text-blue-700 hover:underline font-medium"
                  >
                    '{whitepaper.title}'
                  </a>
                  {parts[1]}
                </>
              ) : hasAmpyard ? (
                <>
                  {parts[0]}
                  <a
                    href={ampyard.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-blue-600 hover:text-blue-700 hover:underline font-medium"
                  >
                    {ampyard.name}
                  </a>
                  {parts[1]}
                </>
              ) : parts[0]}
            </p>
          );
        })}
      </div>
    </div>
  </div>
</section>
