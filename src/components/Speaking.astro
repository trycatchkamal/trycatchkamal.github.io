---
import resumeData from '../data/resume.json';
const { speaking, trainings } = resumeData;

// Combine and sort all speaking engagements
const allEvents = [
  ...speaking.map(s => ({ ...s, type: 'talk' })),
  ...trainings.map(t => ({ ...t, type: 'workshop' }))
];
---

<section id="speaking" class="section-container bg-gradient-to-br from-purple-50 to-pink-50">
  <div class="mb-12 scroll-mt-24 text-center">
    <h2 class="text-3xl md:text-4xl font-bold mb-3 text-gray-900 flex items-center justify-center">
      <svg class="w-10 h-10 mr-3 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/>
      </svg>
      Speaking & Training
    </h2>
    <p class="text-gray-600 text-lg">Sharing knowledge at conferences and workshops</p>
  </div>

  <div class="max-w-3xl mx-auto">
    <!-- Vertical Timeline -->
    <div class="relative">
      <!-- Timeline Line -->
      <div class="absolute left-8 md:left-1/2 transform md:-translate-x-1/2 h-full w-1 bg-gradient-to-b from-purple-200 via-pink-200 to-transparent"></div>

      <div class="space-y-12">
        {allEvents.map((event, index) => (
          <div class={`relative flex items-start ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
            <!-- Timeline Dot -->
            <div class="absolute left-8 md:left-1/2 transform md:-translate-x-1/2 -translate-y-1">
              <div class={`w-6 h-6 rounded-full border-4 border-white shadow-lg ${event.type === 'talk' ? 'bg-purple-500' : 'bg-pink-500'}`}></div>
            </div>

            <!-- Content Card -->
            <div class={`ml-20 md:ml-0 w-full ${index % 2 === 0 ? 'md:pr-8 md:text-right' : 'md:pl-8 md:text-left'} md:w-1/2`}>
              {event.link ? (
                <a
                  href={event.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block group"
                >
                  <div class={`bg-white rounded-xl p-6 shadow-lg hover:shadow-xl transition-all duration-300 border-2 ${event.type === 'talk' ? 'border-purple-200 hover:border-purple-400' : 'border-pink-200 hover:border-pink-400'}`}>
                    <div class="flex items-center mb-3">
                      <span class={`px-3 py-1 rounded-full text-xs font-semibold ${event.type === 'talk' ? 'bg-purple-100 text-purple-700' : 'bg-pink-100 text-pink-700'} ${index % 2 === 0 ? 'md:ml-auto' : ''}`}>
                        {event.type === 'talk' ? '🎤 Public Talk' : '🎓 Workshop'}
                      </span>
                    </div>
                    <h3 class={`text-lg font-bold text-gray-900 mb-2 ${event.type === 'talk' ? 'group-hover:text-purple-600' : 'group-hover:text-pink-600'} transition-colors`}>
                      {event.title}
                    </h3>
                    <div class={`flex items-center ${event.type === 'talk' ? 'text-purple-600' : 'text-pink-600'} font-medium text-sm ${index % 2 === 0 ? 'md:justify-end' : ''}`}>
                      <span>View Details</span>
                      <svg class="w-4 h-4 ml-1 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                      </svg>
                    </div>
                  </div>
                </a>
              ) : (
                <div class={`bg-white rounded-xl p-6 shadow-lg border-2 ${event.type === 'talk' ? 'border-purple-200' : 'border-pink-200'}`}>
                  <div class="flex items-center mb-3">
                    <span class={`px-3 py-1 rounded-full text-xs font-semibold ${event.type === 'talk' ? 'bg-purple-100 text-purple-700' : 'bg-pink-100 text-pink-700'} ${index % 2 === 0 ? 'md:ml-auto' : ''}`}>
                      {event.type === 'talk' ? '🎤 Public Talk' : '🎓 Workshop'}
                    </span>
                  </div>
                  <h3 class="text-lg font-bold text-gray-900">
                    {event.title}
                  </h3>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
