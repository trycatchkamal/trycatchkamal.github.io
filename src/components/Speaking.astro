---
import resumeData from '../data/resume.json';
const { speaking, trainings } = resumeData;
---

<section id="speaking" class="section-container bg-gray-50">
  <div class="mb-12 scroll-mt-24">
    <h2 class="text-3xl md:text-4xl font-semibold mb-2 text-gray-900">🎤 Speaking & Training</h2>
  </div>

  <div class="grid md:grid-cols-2 gap-8">
    <div>
      <h3 class="text-2xl font-semibold mb-6 text-gray-900">Public Talks</h3>
      <div class="space-y-4">
        {speaking.map(talk => (
          <a
            href={talk.link}
            target="_blank"
            rel="noopener noreferrer"
            class="block card hover:border-accent"
          >
            <p class="font-medium text-gray-900 hover:text-accent transition-colors">{talk.title}</p>
          </a>
        ))}
      </div>
    </div>

    <div>
      <h3 class="text-2xl font-semibold mb-6 text-gray-900">Workshops Conducted</h3>
      <div class="space-y-4">
        {trainings.map(training => (
          <div class="card">
            <p class="font-medium text-gray-900">{training.title}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
