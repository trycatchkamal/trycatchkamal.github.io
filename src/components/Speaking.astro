---
import resumeData from '../data/resume.json';
const { speaking, trainings } = resumeData;
---

<section id="speaking" class="section-container bg-gradient-to-br from-purple-50 to-pink-50">
  <div class="mb-12 scroll-mt-24 text-center">
    <h2 class="text-3xl md:text-4xl font-bold mb-3 text-gray-900 flex items-center justify-center">
      <svg class="w-10 h-10 mr-3 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/>
      </svg>
      Speaking & Training
    </h2>
    <p class="text-gray-600 text-lg">Sharing knowledge at conferences and workshops</p>
  </div>

  <!-- Vertical Timeline (all screen sizes) -->
  <div class="relative max-w-3xl md:max-w-5xl mx-auto px-4">
    <!-- Timeline Line -->
    <div class="absolute left-4 md:left-1/2 md:-translate-x-1/2 top-0 bottom-0 w-0.5 bg-gradient-to-b from-purple-300 via-pink-300 to-purple-200"></div>

    <div class="space-y-6 md:space-y-8">
      {[...speaking.map(s => ({ ...s, type: 'talk' })), ...trainings.map(t => ({ ...t, type: 'workshop' }))].map((event, index) => (
        <div class={`relative flex items-start ${index % 2 === 0 ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
          <!-- Timeline Dot with Pulse Effect -->
          <div class="absolute left-4 md:left-1/2 md:-translate-x-1/2 top-6">
            <div class={`relative w-5 h-5 rounded-full border-4 border-white shadow-lg ${event.type === 'talk' ? 'bg-purple-500' : 'bg-pink-500'}`}>
              <div class={`absolute inset-0 rounded-full ${event.type === 'talk' ? 'bg-purple-400' : 'bg-pink-400'} animate-ping opacity-75`}></div>
            </div>
          </div>

          <!-- Content Card -->
          <div class={`pl-12 md:pl-0 w-full ${index % 2 === 0 ? 'md:pr-12 md:text-right' : 'md:pl-12 md:text-left'} md:w-1/2`}>
            {event.link ? (
              <a
                href={event.link}
                target="_blank"
                rel="noopener noreferrer"
                class="block group"
              >
                <div class={`bg-white rounded-xl p-5 shadow-lg hover:shadow-xl transition-all duration-300 border-l-4 md:border-l-0 md:border-2 ${event.type === 'talk' ? 'border-l-purple-500 md:border-purple-200 hover:md:border-purple-400' : 'border-l-pink-500 md:border-pink-200 hover:md:border-pink-400'}`}>
                  <span class={`inline-block px-3 py-1 rounded-full text-xs font-semibold mb-3 ${event.type === 'talk' ? 'bg-purple-100 text-purple-700' : 'bg-pink-100 text-pink-700'} ${index % 2 === 0 ? 'md:float-right md:ml-2' : 'md:float-left md:mr-2'}`}>
                    {event.type === 'talk' ? '🎤 Talk' : '🎓 Workshop'}
                  </span>
                  <h3 class={`text-base font-bold text-gray-900 leading-tight ${event.type === 'talk' ? 'group-hover:text-purple-600' : 'group-hover:text-pink-600'} transition-colors clear-both`}>
                    {event.title}
                  </h3>
                </div>
              </a>
            ) : (
              <div class={`bg-white rounded-xl p-5 shadow-lg border-l-4 md:border-l-0 md:border-2 ${event.type === 'talk' ? 'border-l-purple-500 md:border-purple-200' : 'border-l-pink-500 md:border-pink-200'}`}>
                <span class={`inline-block px-3 py-1 rounded-full text-xs font-semibold mb-3 ${event.type === 'talk' ? 'bg-purple-100 text-purple-700' : 'bg-pink-100 text-pink-700'} ${index % 2 === 0 ? 'md:float-right md:ml-2' : 'md:float-left md:mr-2'}`}>
                  {event.type === 'talk' ? '🎤 Talk' : '🎓 Workshop'}
                </span>
                <h3 class="text-base font-bold text-gray-900 leading-tight clear-both">
                  {event.title}
                </h3>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
