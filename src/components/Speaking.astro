---
import resumeData from '../data/resume.json';
const { speaking, trainings } = resumeData;
---

<section id="speaking" class="section-container bg-gradient-to-br from-purple-50 to-pink-50">
  <div class="mb-12 scroll-mt-24 text-center">
    <h2 class="text-3xl md:text-4xl font-bold mb-3 text-gray-900 flex items-center justify-center">
      <svg class="w-10 h-10 mr-3 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/>
      </svg>
      Speaking & Training
    </h2>
    <p class="text-gray-600 text-lg">Sharing knowledge at conferences and workshops</p>
  </div>

  <!-- Mobile: Single Timeline -->
  <div class="md:hidden relative max-w-3xl mx-auto">
    <!-- Timeline Line -->
    <div class="absolute left-6 top-0 bottom-0 w-0.5 bg-gradient-to-b from-purple-300 via-pink-300 to-purple-200"></div>

    <div class="space-y-6">
      {[...speaking.map(s => ({ ...s, type: 'talk' })), ...trainings.map(t => ({ ...t, type: 'workshop' }))].map((event) => (
        <div class="relative flex items-start">
          <!-- Timeline Dot with Pulse Effect -->
          <div class="absolute left-6 -translate-x-1/2 top-4">
            <div class={`relative w-4 h-4 rounded-full border-2 border-white shadow-lg ${event.type === 'talk' ? 'bg-purple-500' : 'bg-pink-500'}`}>
              <div class={`absolute inset-0 rounded-full ${event.type === 'talk' ? 'bg-purple-400' : 'bg-pink-400'} animate-ping opacity-75`}></div>
            </div>
          </div>

          <!-- Content Card -->
          <div class="pl-12 flex-1">
            {event.link ? (
              <a
                href={event.link}
                target="_blank"
                rel="noopener noreferrer"
                class="block group"
              >
                <div class={`bg-white rounded-xl p-4 shadow-md hover:shadow-lg transition-all duration-300 border-l-4 ${event.type === 'talk' ? 'border-l-purple-500' : 'border-l-pink-500'}`}>
                  <span class={`inline-block px-2.5 py-1 rounded-full text-xs font-semibold mb-2 ${event.type === 'talk' ? 'bg-purple-100 text-purple-700' : 'bg-pink-100 text-pink-700'}`}>
                    {event.type === 'talk' ? '🎤 Talk' : '🎓 Workshop'}
                  </span>
                  <h3 class={`text-sm font-bold text-gray-900 leading-tight ${event.type === 'talk' ? 'group-hover:text-purple-600' : 'group-hover:text-pink-600'} transition-colors`}>
                    {event.title}
                  </h3>
                </div>
              </a>
            ) : (
              <div class={`bg-white rounded-xl p-4 shadow-md border-l-4 ${event.type === 'talk' ? 'border-l-purple-500' : 'border-l-pink-500'}`}>
                <span class={`inline-block px-2.5 py-1 rounded-full text-xs font-semibold mb-2 ${event.type === 'talk' ? 'bg-purple-100 text-purple-700' : 'bg-pink-100 text-pink-700'}`}>
                  {event.type === 'talk' ? '🎤 Talk' : '🎓 Workshop'}
                </span>
                <h3 class="text-sm font-bold text-gray-900 leading-tight">
                  {event.title}
                </h3>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Desktop: Two Columns with Timelines -->
  <div class="hidden md:grid md:grid-cols-2 gap-12 max-w-6xl mx-auto">
    <!-- Left Column: Public Talks -->
    <div class="relative">
      <h3 class="text-2xl font-bold mb-8 text-purple-600 flex items-center justify-center">
        <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11a7 7 0 01-7 7m0 0a7 7 0 01-7-7m7 7v4m0 0H8m4 0h4m-4-8a3 3 0 01-3-3V5a3 3 0 116 0v6a3 3 0 01-3 3z"/>
        </svg>
        Public Talks
      </h3>

      <!-- Timeline Line for Talks -->
      <div class="absolute left-6 top-20 bottom-0 w-0.5 bg-gradient-to-b from-purple-300 to-purple-100"></div>

      <div class="space-y-6">
        {speaking.map((talk, index) => (
          <div class="relative">
            <!-- Timeline Dot -->
            <div class="absolute left-6 -translate-x-1/2 top-6">
              <div class="relative w-4 h-4 rounded-full border-2 border-white shadow-lg bg-purple-500">
                <div class="absolute inset-0 rounded-full bg-purple-400 animate-ping opacity-75"></div>
              </div>
            </div>

            <!-- Content -->
            <div class="pl-12">
              {talk.link ? (
                <a
                  href={talk.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block group"
                >
                  <div class="bg-white rounded-xl p-5 shadow-lg hover:shadow-xl transition-all duration-300 border-2 border-purple-200 hover:border-purple-400">
                    <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-purple-100 text-purple-700 mb-3">
                      🎤 Talk
                    </span>
                    <h4 class="text-base font-bold text-gray-900 group-hover:text-purple-600 transition-colors leading-tight">
                      {talk.title}
                    </h4>
                  </div>
                </a>
              ) : (
                <div class="bg-white rounded-xl p-5 shadow-lg border-2 border-purple-200">
                  <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-purple-100 text-purple-700 mb-3">
                    🎤 Talk
                  </span>
                  <h4 class="text-base font-bold text-gray-900 leading-tight">
                    {talk.title}
                  </h4>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Right Column: Training Workshops -->
    <div class="relative">
      <h3 class="text-2xl font-bold mb-8 text-pink-600 flex items-center justify-center">
        <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
        </svg>
        Training Workshops
      </h3>

      <!-- Timeline Line for Workshops -->
      <div class="absolute left-6 top-20 bottom-0 w-0.5 bg-gradient-to-b from-pink-300 to-pink-100"></div>

      <div class="space-y-6">
        {trainings.map((training, index) => (
          <div class="relative">
            <!-- Timeline Dot -->
            <div class="absolute left-6 -translate-x-1/2 top-6">
              <div class="relative w-4 h-4 rounded-full border-2 border-white shadow-lg bg-pink-500">
                <div class="absolute inset-0 rounded-full bg-pink-400 animate-ping opacity-75"></div>
              </div>
            </div>

            <!-- Content -->
            <div class="pl-12">
              {training.link ? (
                <a
                  href={training.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block group"
                >
                  <div class="bg-white rounded-xl p-5 shadow-lg hover:shadow-xl transition-all duration-300 border-2 border-pink-200 hover:border-pink-400">
                    <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-pink-100 text-pink-700 mb-3">
                      🎓 Workshop
                    </span>
                    <h4 class="text-base font-bold text-gray-900 group-hover:text-pink-600 transition-colors leading-tight">
                      {training.title}
                    </h4>
                  </div>
                </a>
              ) : (
                <div class="bg-white rounded-xl p-5 shadow-lg border-2 border-pink-200">
                  <span class="inline-block px-3 py-1 rounded-full text-xs font-semibold bg-pink-100 text-pink-700 mb-3">
                    🎓 Workshop
                  </span>
                  <h4 class="text-base font-bold text-gray-900 leading-tight">
                    {training.title}
                  </h4>
                </div>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
