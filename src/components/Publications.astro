---
import resumeData from '../data/resume.json';
const { publications } = resumeData;
---

<section id="publications" class="section-container bg-gradient-to-br from-violet-50 to-purple-50">
  <div class="mb-12 scroll-mt-24 text-center">
    <h2 class="text-3xl md:text-4xl font-bold mb-3 text-gray-900 flex items-center justify-center">
      <svg class="w-10 h-10 mr-3 text-violet-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
      </svg>
      Research Papers
    </h2>
    <p class="text-gray-600 text-lg">Published research and whitepapers on AI, software engineering, and agile practices</p>
  </div>

  <div class="max-w-4xl mx-auto flex flex-col gap-6">
    {publications.map((paper) => (
      <div class="group bg-white rounded-2xl shadow-lg hover:shadow-xl transition-all duration-300 border-l-4 border-violet-500 p-8">
        <div class="flex items-start justify-between gap-4 flex-wrap">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-3 flex-wrap">
              <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-violet-100 text-violet-700">
                {paper.type}
              </span>
              {paper.community && (
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-purple-100 text-purple-700">
                  {paper.community}
                </span>
              )}
              <span class="text-gray-400 text-xs">{paper.year} · {paper.publisher}</span>
            </div>

            <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-violet-600 transition-colors">
              {paper.title}
            </h3>

            <p class="text-sm text-gray-500 mb-3 flex items-center">
              <svg class="w-4 h-4 mr-2 text-gray-400 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
              {paper.authors}
            </p>

            <p class="text-gray-600 text-sm mb-5 leading-relaxed">
              {paper.description}
            </p>

            <div class="flex flex-wrap gap-3">
              <a
                href={paper.link}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center px-4 py-2 rounded-lg bg-violet-600 text-white text-sm font-semibold hover:bg-violet-700 transition-colors"
              >
                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
                Read Paper
              </a>
              {paper.doi && (
                <a
                  href={paper.doi}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center px-4 py-2 rounded-lg border border-violet-300 text-violet-700 text-sm font-semibold hover:bg-violet-50 transition-colors"
                >
                  <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/>
                  </svg>
                  DOI
                </a>
              )}
            </div>
          </div>

          <div class="flex-shrink-0 hidden sm:flex items-center justify-center w-16 h-16 rounded-full bg-violet-100">
            <svg class="w-8 h-8 text-violet-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
