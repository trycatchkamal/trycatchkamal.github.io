---
import resumeData from '../data/resume.json';
const { speaking, trainings } = resumeData;
const photos = resumeData.speakingPhotos ?? [];
const calendarUrl = resumeData.profile.calendarUrl;
---

<section id="talks" class="section-paper">
  <div class="mx-auto max-w-6xl px-6 py-20 md:px-8 md:py-28">
    <div class="grid items-center gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:gap-14">
      {photos[0] && (
        <figure class="group relative overflow-hidden rounded-3xl bg-slate-100 shadow-lg ring-1 ring-slate-200">
          <img
            src={photos[0].src}
            alt={photos[0].alt}
            class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-[1.03]"
            loading="eager"
          />
        </figure>
      )}

      <div>
        <p class="eyebrow mb-5">Speaking</p>
        <h1 class="text-4xl font-bold tracking-[-0.04em] md:text-6xl">
          Talks
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-slate-600">
          I speak at international conferences on AI, technical agility, and
          software engineering &mdash; and run internal engineering days and
          leadership sessions for teams who want the same conversation in private.
        </p>
        <a href={calendarUrl} target="_blank" rel="noopener noreferrer" class="btn-primary mt-8">
          Invite me to speak <span class="ml-2" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>


    <div class="mt-24">
      <div class="max-w-2xl">
        <p class="eyebrow">Selected events</p>
        <h2 class="mt-3 text-3xl font-bold tracking-[-0.03em] md:text-4xl">
          Where I&rsquo;ve spoken
        </h2>
        <p class="mt-4 leading-relaxed text-slate-600">
          Conferences, talks, webinars, and workshops.
        </p>
      </div>

      <!-- Rail sits on the left below lg, and down the centre from lg up. -->
      <div class="relative mt-14">
        <div
          class="absolute bottom-2 left-[7px] top-2 w-px bg-gradient-to-b from-cyan-400 via-blue-500 to-violet-400 lg:left-1/2 lg:-translate-x-1/2"
          aria-hidden="true"
        >
        </div>

        <div class="space-y-4 lg:space-y-8">
          {speaking.map((talk, index) => (
            <div class={`group relative lg:flex ${index % 2 === 0 ? 'lg:justify-start' : 'lg:justify-end'}`}>
              <span
                class="absolute -left-[9px] top-5 z-10 flex h-8 w-8 items-center justify-center rounded-full bg-white text-sm shadow-md ring-1 ring-slate-200 transition group-hover:ring-blue-300 lg:left-1/2 lg:-translate-x-1/2"
                aria-hidden="true"
              >
                🎤
              </span>

              <a
                href={talk.link || undefined}
                target={talk.link ? '_blank' : undefined}
                rel={talk.link ? 'noopener noreferrer' : undefined}
                class={`ml-7 block rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition md:p-6 lg:ml-0 lg:w-[calc(50%-2.5rem)] ${talk.link ? 'hover:-translate-y-0.5 hover:border-blue-300 hover:shadow-lg' : ''}`}
              >
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <h3 class="text-lg font-semibold leading-snug text-slate-900 group-hover:text-blue-600">
                      {talk.title}
                    </h3>
                    {talk.venue && (
                      <p class="mt-1.5 text-sm text-slate-500">{talk.venue}</p>
                    )}
                    {talk.topic && (
                      <span class="mt-3 inline-flex items-center rounded-full bg-blue-50 px-2.5 py-1 text-xs font-semibold text-blue-700">
                        {talk.topic}
                      </span>
                    )}
                  </div>
                  {talk.link && (
                    <span class="text-xl text-slate-400 transition group-hover:text-blue-600" aria-hidden="true">↗</span>
                  )}
                </div>
              </a>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="mt-20 border-t border-slate-200 pt-12">
      <p class="eyebrow">Training programmes</p>
      <h2 class="mt-3 text-3xl font-bold tracking-[-0.03em] md:text-4xl">
        Want something longer than a talk?
      </h2>
      <p class="mt-4 max-w-2xl leading-relaxed text-slate-600">
        These run as multi-day programmes for your leadership team, built around
        your context rather than a fixed syllabus.
      </p>
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        {trainings.map((training) => (
          <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm">
            <h3 class="text-lg font-semibold">{training.title}</h3>
            <p class="mt-2 text-sm text-slate-600">
              Custom training for your team and technology leaders.
            </p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
