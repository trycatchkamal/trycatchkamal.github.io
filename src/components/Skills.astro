---
import resumeData from '../data/resume.json';
const { skills } = resumeData;
---

<section id="skills" class="section-container bg-gradient-to-br from-indigo-50 to-blue-50">
  <div class="mb-12 scroll-mt-24 text-center">
    <h2 class="text-3xl md:text-4xl font-bold mb-3 text-gray-900 flex items-center justify-center">
      <svg class="w-10 h-10 mr-3 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/>
      </svg>
      Skills & Expertise
    </h2>
    <p class="text-gray-600 text-lg">Core competencies and technical proficiencies</p>
  </div>

  <div class="flex flex-wrap gap-4 justify-center max-w-4xl mx-auto">
    {skills.map((skill, index) => (
      <span class="group relative bg-white hover:bg-gradient-to-r hover:from-indigo-500 hover:to-blue-500 text-gray-800 hover:text-white font-semibold px-6 py-3 rounded-xl shadow-md hover:shadow-xl transition-all duration-300 border-2 border-indigo-200 hover:border-transparent transform hover:scale-105 cursor-default">
        <span class="flex items-center">
          <svg class="w-5 h-5 mr-2 text-indigo-500 group-hover:text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
          {skill}
        </span>
      </span>
    ))}
  </div>
</section>
