---
import resumeData from '../data/resume.json';
const { skills } = resumeData;
---

<section id="skills" class="section-dark">
  <div class="mx-auto max-w-7xl px-6 py-20 md:px-8 md:py-28">
    <div class="max-w-3xl">
      <p class="eyebrow-dark">Expertise</p>
      <h2 class="section-title-dark">What I can help you with.</h2>
      <p class="section-lede-dark">
        AI adoption on one side, engineering craft on the other. In practice you
        never get one without the other.
      </p>
    </div>

    <ul class="mt-12 flex max-w-5xl flex-wrap gap-3">
      {skills.map((skill) => (
        <li class="inline-flex items-center rounded-full border border-slate-700 bg-slate-900 px-5 py-3 font-semibold text-slate-100 transition duration-300 hover:border-cyan-300 hover:text-cyan-200">
          <span class="mr-2.5 h-1.5 w-1.5 rounded-full bg-cyan-300" aria-hidden="true"></span>
          {skill}
        </li>
      ))}
    </ul>
  </div>
</section>
