---
import resumeData from '../data/resume.json';
const { skills } = resumeData;
---

<section id="skills" class="section-container bg-gray-50">
  <div class="mb-12 scroll-mt-24">
    <h2 class="text-3xl md:text-4xl font-semibold mb-2 text-gray-900">Skills & Expertise</h2>
  </div>

  <div class="flex flex-wrap gap-3 justify-center">
    {skills.map(skill => (
      <span class="badge">
        {skill}
      </span>
    ))}
  </div>
</section>
