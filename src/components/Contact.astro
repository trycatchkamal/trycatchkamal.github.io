---
import resumeData from '../data/resume.json';
const { profile, ampyard } = resumeData;

const footerLinks = [
  { label: 'Services', href: '/services' },
  { label: 'Talks', href: '/talks' },
  { label: 'Publications', href: '/published-work' },
  { label: 'Open source', href: '/open-source' }
];

const socials = [
  { label: 'LinkedIn', href: `https://www.linkedin.com/in/${profile.linkedin}/` },
  { label: 'GitHub', href: `https://github.com/${profile.github}` },
  { label: 'X', href: `https://x.com/${profile.twitter}` }
];
---

<footer id="contact" class="section-dark">
  <div class="mx-auto max-w-7xl px-6 md:px-8">
    <!-- Closing call to action -->
    <div class="border-b border-slate-800 py-20 md:py-28">
      <div class="grid gap-10 lg:grid-cols-[1fr_auto] lg:items-end">
        <div>
          <p class="eyebrow-dark">Get in touch</p>
          <h2 class="mt-5 max-w-3xl text-4xl font-bold leading-[1.05] tracking-[-0.04em] md:text-5xl">
            Trying to make AI work in your engineering team? Tell me about it.
          </h2>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate-400">
            Consulting, workshops, talks or mentoring. Have a look at how I work,
            or just send me an email.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="/services" class="btn-primary-dark">
            Hire me <span class="ml-2" aria-hidden="true">↗</span>
          </a>
          <a href={`mailto:${profile.email}`} class="btn-ghost-dark">Email me</a>
        </div>
      </div>
    </div>

    <!-- Footer navigation -->
    <div class="grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <p class="text-lg font-bold tracking-[-0.02em] text-white">{profile.name}</p>
        <p class="mt-2 max-w-xs text-sm leading-relaxed text-slate-400">
          AI consultant and tech coach. Cofounder &amp; Director at
          <a
            href={ampyard.link}
            target="_blank"
            rel="noopener noreferrer"
            class="text-slate-300 underline underline-offset-4 transition hover:text-cyan-300"
          >{ampyard.name}</a>.
        </p>
      </div>

      <nav aria-label="Footer">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Explore</p>
        <ul class="mt-4 space-y-2.5">
          {footerLinks.map((link) => (
            <li>
              <a href={link.href} class="text-sm text-slate-400 transition hover:text-cyan-300">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-slate-500">Elsewhere</p>
        <ul class="mt-4 space-y-2.5">
          {socials.map((social) => (
            <li>
              <a
                href={social.href}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm text-slate-400 transition hover:text-cyan-300"
              >
                {social.label} <span aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
          <li>
            <a
              href={`mailto:${profile.email}`}
              class="text-sm text-slate-400 transition hover:text-cyan-300"
            >
              Email
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="border-t border-slate-800 py-8">
      <p class="text-sm text-slate-500">
        © {new Date().getFullYear()} {profile.name}. Built with Astro &amp; Tailwind CSS.
      </p>
    </div>
  </div>
</footer>
