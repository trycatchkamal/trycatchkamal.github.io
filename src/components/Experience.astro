---
import resumeData from '../data/resume.json';
const { experience } = resumeData;

// Helper function to split details into bullet points
function getDetails(details: string): string[] {
  return details
    .split('\n')
    .filter(line => line.trim().startsWith('★') || line.trim().startsWith('-'))
    .map(line => line.trim().replace(/^[★-]\s*/, ''));
}
---

<section id="experience" class="section-container">
  <div class="mb-12 scroll-mt-24">
    <h2 class="text-3xl md:text-4xl font-semibold mb-2 text-gray-900">Professional Experience</h2>
  </div>

  <div class="space-y-12">
    {experience.map((job) => (
      <div class="relative pl-8 border-l-2 border-gray-300 last:border-transparent">
        <div class="absolute left-[-9px] top-0 w-4 h-4 rounded-full bg-accent border-4 border-white"></div>

        <div class="card">
          <div class="flex flex-col md:flex-row md:justify-between md:items-start mb-4">
            <div>
              <h3 class="text-xl font-semibold text-gray-900">{job.role}</h3>
              <p class="text-accent font-medium">{job.company}</p>
            </div>
            <span class="text-sm text-gray-500 mt-1 md:mt-0">{job.period}</span>
          </div>

          <ul class="space-y-2">
            {getDetails(job.details).map(detail => (
              <li class="text-gray-700 flex items-start">
                <span class="text-accent mr-2 flex-shrink-0">★</span>
                <span>{detail}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    ))}
  </div>
</section>
