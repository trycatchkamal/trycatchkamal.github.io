---
import resumeData from '../data/resume.json';
const { books } = resumeData;
---

<section id="books" class="section-container bg-gradient-to-br from-amber-50 to-orange-50">
  <div class="mb-12 scroll-mt-24 text-center">
    <h2 class="text-3xl md:text-4xl font-bold mb-3 text-gray-900 flex items-center justify-center">
      <svg class="w-10 h-10 mr-3 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
      </svg>
      Published Books
    </h2>
    <p class="text-gray-600 text-lg">Author of technical books on Test-Driven Development</p>
  </div>

  <div class="grid md:grid-cols-2 gap-8 max-w-5xl mx-auto">
    {books.map((book, index) => (
      <a
        href={book.link}
        target="_blank"
        rel="noopener noreferrer"
        class="group bg-white rounded-2xl shadow-xl hover:shadow-2xl transition-all duration-300 overflow-hidden hover:scale-105"
      >
        <div class="flex flex-col md:flex-row">
          <!-- Book Cover Placeholder -->
          <div class="md:w-48 h-64 md:h-auto bg-gradient-to-br from-blue-600 to-indigo-700 flex items-center justify-center p-6">
            <div class="text-center text-white">
              <svg class="w-20 h-20 mx-auto mb-3 opacity-80" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
              </svg>
              <p class="text-xs font-bold uppercase tracking-wider">TDD</p>
            </div>
          </div>

          <!-- Book Details -->
          <div class="flex-1 p-6">
            <h3 class="text-xl md:text-2xl font-bold text-gray-900 mb-3 group-hover:text-blue-600 transition-colors line-clamp-2">
              {book.title}
            </h3>
            <p class="text-gray-600 mb-4 flex items-center">
              <svg class="w-5 h-5 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
              </svg>
              {book.authors}
            </p>
            <div class="flex items-center text-blue-600 font-semibold group-hover:text-blue-700">
              <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
                <path d="M19.5 3.5L18 2l-1.5 1.5L15 2l-1.5 1.5L12 2l-1.5 1.5L9 2 7.5 3.5 6 2v14H3v3c0 1.66 1.34 3 3 3h12c1.66 0 3-1.34 3-3V2l-1.5 1.5zM19 19c0 .55-.45 1-1 1s-1-.45-1-1v-3H8V5h11v14z"/>
              </svg>
              <span>View on Amazon</span>
              <svg class="w-4 h-4 ml-2 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </div>
          </div>
        </div>
      </a>
    ))}
  </div>
</section>
